# Copy this file to ".env" (same folder) and fill in the values. The backend reads it at startup.

# ---- Fast answers: a hosted model (recommended) ----------------------------------
# Free key from https://console.groq.com  ->  API Keys. With a key set, the whole
# analysis takes about 15 seconds instead of several minutes on a laptop CPU.
PROJECTIQ_API_KEY=

# Optional: provider and model. Defaults: groq + llama-3.3-70b-versatile.
# If you hit rate limits on a free plan, try a smaller model such as llama-3.1-8b-instant.
# Model names change over time; use one listed in your provider's console.
# PROJECTIQ_LLM_PROVIDER=groq
# PROJECTIQ_CHAT_MODEL=llama-3.3-70b-versatile

# Other providers: gemini (GEMINI_API_KEY), or any OpenAI-compatible service:
# PROJECTIQ_LLM_PROVIDER=openai
# PROJECTIQ_API_BASE=https://api.openai.com/v1
# PROJECTIQ_CHAT_MODEL=gpt-4o-mini

# ---- Fully offline alternative -----------------------------------------------------
# Leave PROJECTIQ_API_KEY empty (or set the line below) to use Ollama. Slow without a GPU.
# PROJECTIQ_LLM_PROVIDER=ollama
# PROJECTIQ_CHAT_MODEL=llama3.2:3b

# ---- Embeddings ----------------------------------------------------------------------
# Default "local" uses a small built-in model (downloaded once, ~80 MB). No Ollama needed.
# PROJECTIQ_EMBED_PROVIDER=local
